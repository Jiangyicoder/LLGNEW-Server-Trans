<Window x:Class="LLG.Helper.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 · LLG 订阅助手" Width="420" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Closing="OnClosing">
  <StackPanel Margin="28,24,28,28">
    <TextBlock Text="账号设置" FontSize="25" FontWeight="Bold" Margin="0,0,0,8" />
    <TextBlock Text="保存后，用于更新服务器列表时登录。" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,0,0,24" />
    <Label Content="用户名" Target="{Binding ElementName=UsernameBox}" Padding="0" Margin="0,0,0,8" FontSize="14" />
    <TextBox x:Name="UsernameBox" MaxLength="320" AutomationProperties.AutomationId="UsernameBox" AutomationProperties.Name="用户名" />
    <Label Content="密码" Target="{Binding ElementName=PasswordInput}" Padding="0" Margin="0,18,0,8" FontSize="14" />
    <PasswordBox x:Name="PasswordInput" MaxLength="1024" AutomationProperties.AutomationId="PasswordInput" AutomationProperties.Name="密码" />
    <TextBlock Text="账号信息加密保存在当前 Windows 用户下。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,14,0,0" TextWrapping="Wrap" />
    <TextBlock x:Name="ErrorText" Foreground="#B42318" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
    <Button x:Name="SaveButton" Content="保存" Style="{StaticResource PrimaryButton}" Height="46" Margin="0,24,0,0" IsDefault="True" Click="Save" AutomationProperties.AutomationId="SaveButton" />
  </StackPanel>
</Window>
