<Window x:Class="LLG.Helper.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LLG 订阅助手" Width="500" Height="580" MinWidth="480" MinHeight="570" WindowStartupLocation="CenterScreen" Loaded="OnLoaded" Closing="OnClosing">
  <Grid Margin="32,14,32,22">
    <Grid.RowDefinitions><RowDefinition Height="30" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Button x:Name="SettingsButton" Content="设置" HorizontalAlignment="Right" Style="{StaticResource ButtonBase}" Background="Transparent" BorderBrush="Transparent" Foreground="{StaticResource Blue}" Padding="10,3" FontSize="16" Click="OpenSettings" AutomationProperties.AutomationId="SettingsButton" />
    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,16,0,14">
      <TextBlock Text="LLG 订阅助手" FontSize="36" FontWeight="Bold" Margin="0,0,0,12" />
      <TextBlock Text="更新线路，一键复制到 v2rayN" Foreground="{StaticResource Muted}" FontSize="16" Margin="0,0,0,32" />
      <Button x:Name="UpdateButton" Content="更新服务器列表" Height="82" FontSize="22" FontWeight="SemiBold" Style="{StaticResource PrimaryButton}" Click="UpdateServers" AutomationProperties.AutomationId="UpdateButton" />
      <Button x:Name="ConvertButton" Content="转换为可导入" Height="82" FontSize="22" FontWeight="SemiBold" Margin="0,16,0,0" Style="{StaticResource SecondaryButton}" IsEnabled="False" Click="ConvertAndCopy" AutomationProperties.AutomationId="ConvertButton" />
    </StackPanel>
    <StackPanel Grid.Row="2" Margin="0,10,0,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Image x:Name="StatusIcon" Source="{StaticResource StatusInfo}" Width="20" Height="20" VerticalAlignment="Top" Margin="0,2,0,0" />
        <TextBlock x:Name="StatusText" Grid.Column="1" Text="请先在设置中保存账号" FontSize="16" TextWrapping="Wrap" Margin="10,0,0,0" AutomationProperties.LiveSetting="Polite" />
      </Grid>
      <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Image Source="{StaticResource StatusClock}" Width="20" Height="20" />
        <TextBlock x:Name="UpdatedText" Grid.Column="1" Text="尚未更新服务器列表" Foreground="{StaticResource Muted}" FontSize="14" Margin="10,0,0,0" />
      </Grid>
      <ProgressBar x:Name="BusyProgress" Height="3" IsIndeterminate="True" Visibility="Collapsed" Foreground="{StaticResource Blue}" Margin="0,12,0,0" />
    </StackPanel>
    <Border Grid.Row="3" Height="1" Background="#D7DCE4" Margin="0,22,0,18" />
    <TextBlock Grid.Row="4" Text="复制后，在 v2rayN 主窗口按 Ctrl+V 导入" Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" />
  </Grid>
</Window>
